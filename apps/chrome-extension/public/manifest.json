{
  "manifest_version": 3,
  "name": "AI Resume Builder",
  "version": "1.0.0",
  "description": "Paste a job description and generate a tailored resume via the local resume-builder service.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Resume Builder"
  },
  "permissions": ["downloads"],
  "host_permissions": ["http://127.0.0.1:8787/*", "http://localhost:8787/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
