# AI provider: mock | openai | cursor
AI_PROVIDER=mock

# OpenAI-compatible API (used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Cursor Agent SDK (used when AI_PROVIDER=cursor)
# Official docs: https://cursor.com/docs/sdk/typescript
# Note: Cursor provides an agent SDK, not a chat-completions API.
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

# Local HTTP service
HOST=127.0.0.1
PORT=8787
# Comma-separated Chrome extension IDs allowed to call the service
ALLOWED_EXTENSION_IDS=
# Max job description length in characters
MAX_JOB_DESCRIPTION_LENGTH=50000
# Request timeout in milliseconds
REQUEST_TIMEOUT_MS=120000

# Profile defaults for the local service
PROFILE_PATH=./assets/profile.yaml
OUTPUT_DIR=./output

# Optional: path to a local Chrome/Chromium binary if Playwright cannot download browsers
# CHROME_PATH=/usr/bin/google-chrome-stable
